<view class="{{'category-page'}}" style="height: {{normalContentHeight}};">
  <navigation-bar background="#fff" isSlot="{{true}}">
    <view class="headerContent">
      <view class="input-container" bindtap="navigateToSearchPage">
        <text class="iconfont icon-Search search-icon" />
        <text class="input-text">输入商家名、品类或商圈</text>
      </view>
    </view>
  </navigation-bar>
  <view class="container">
    <view class="left">
      <view class="top" wx:if="{{topList.length}}">
        <view class="sort-item" wx:for="{{topList}}" wx:key="sort" data-sort="{{item.sort}}" bind:tap="setCategory"
          >{{item.name}}</view
        >
      </view>
      <view class="sort-item selected-item" data-sort="{{selectedItem.sort}}">{{selectedItem.name}}</view>
      <view class="bottom" wx:if="{{bottomList.length}}">
        <view class="sort-item" wx:for="{{bottomList}}" wx:key="sort" data-sort="{{item.sort}}" bind:tap="setCategory"
          >{{item.name}}</view
        >
      </view>
      <view class="left-bottom" />
    </view>
    <scroll-view
      class="right"
      scroll-y
      lower-threshold="100"
      scroll-with-animation
      show-scrollbar="{{false}}"
      enhanced="{{true}}"
    >
      <view class="title">{{selectedItem.name}}</view>
      <view class="right-content">
        <view
          class="right-item"
          wx:for="{{selectedItem.innerList}}"
          wx:key="sort"
          data-val="{{item.name}}"
          bind:tap="toDetail"
        >
          <view class="{{'iconfont right-icon ' + item.icon_name}}" />
          <view class="swiper_label">{{item.name}}</view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
